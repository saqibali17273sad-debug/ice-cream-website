:root {
  --bg: #fff8f5;
  --panel: #ffffff;
  --primary: #ff7aa2;
  --primary-dark: #ea5f8d;
  --text: #181818;
  --muted: #5e5e5e;
  --line: rgba(130, 92, 91, 0.14);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  font-family: "Inter", sans-serif;
  background: linear-gradient(135deg, #fff4f6 0%, #fffaf4 100%);
  color: var(--text);
}

.login-shell {
  width: min(480px, calc(100% - 24px));
}

.login-card {
  background: rgba(255,255,255,0.9);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 30px 26px;
  box-shadow: 0 18px 40px rgba(33, 17, 18, 0.08);
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #ffb5d1);
  color: white;
  font-weight: 800;
}

.brand-box strong,
.brand-box small {
  display: block;
}

.brand-box small {
  color: var(--muted);
}

h1 {
  margin: 0 0 10px;
  font-size: clamp(2rem, 4vw, 2.8rem);
}

.subtitle {
  margin: 0 0 22px;
  color: var(--muted);
  line-height: 1.7;
}

form {
  display: grid;
  gap: 16px;
}

label {
  display: grid;
  gap: 8px;
  color: var(--text);
  font-weight: 600;
}

input {
  width: 100%;
  min-height: 48px;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 0 14px;
  font: inherit;
  outline: none;
}

.primary-btn {
  border: 0;
  min-height: 50px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.primary-btn:hover {
  transform: translateY(-1px);
}

.demo-box {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  display: grid;
  gap: 4px;
}

.demo-box p {
  margin: 0;
  font-weight: 600;
  color: var(--text);
}

.demo-box strong,
.demo-box span {
  font-weight: 700;
}

@media (max-width: 480px) {
  .login-card {
    padding: 24px 18px;
  }
}







































































