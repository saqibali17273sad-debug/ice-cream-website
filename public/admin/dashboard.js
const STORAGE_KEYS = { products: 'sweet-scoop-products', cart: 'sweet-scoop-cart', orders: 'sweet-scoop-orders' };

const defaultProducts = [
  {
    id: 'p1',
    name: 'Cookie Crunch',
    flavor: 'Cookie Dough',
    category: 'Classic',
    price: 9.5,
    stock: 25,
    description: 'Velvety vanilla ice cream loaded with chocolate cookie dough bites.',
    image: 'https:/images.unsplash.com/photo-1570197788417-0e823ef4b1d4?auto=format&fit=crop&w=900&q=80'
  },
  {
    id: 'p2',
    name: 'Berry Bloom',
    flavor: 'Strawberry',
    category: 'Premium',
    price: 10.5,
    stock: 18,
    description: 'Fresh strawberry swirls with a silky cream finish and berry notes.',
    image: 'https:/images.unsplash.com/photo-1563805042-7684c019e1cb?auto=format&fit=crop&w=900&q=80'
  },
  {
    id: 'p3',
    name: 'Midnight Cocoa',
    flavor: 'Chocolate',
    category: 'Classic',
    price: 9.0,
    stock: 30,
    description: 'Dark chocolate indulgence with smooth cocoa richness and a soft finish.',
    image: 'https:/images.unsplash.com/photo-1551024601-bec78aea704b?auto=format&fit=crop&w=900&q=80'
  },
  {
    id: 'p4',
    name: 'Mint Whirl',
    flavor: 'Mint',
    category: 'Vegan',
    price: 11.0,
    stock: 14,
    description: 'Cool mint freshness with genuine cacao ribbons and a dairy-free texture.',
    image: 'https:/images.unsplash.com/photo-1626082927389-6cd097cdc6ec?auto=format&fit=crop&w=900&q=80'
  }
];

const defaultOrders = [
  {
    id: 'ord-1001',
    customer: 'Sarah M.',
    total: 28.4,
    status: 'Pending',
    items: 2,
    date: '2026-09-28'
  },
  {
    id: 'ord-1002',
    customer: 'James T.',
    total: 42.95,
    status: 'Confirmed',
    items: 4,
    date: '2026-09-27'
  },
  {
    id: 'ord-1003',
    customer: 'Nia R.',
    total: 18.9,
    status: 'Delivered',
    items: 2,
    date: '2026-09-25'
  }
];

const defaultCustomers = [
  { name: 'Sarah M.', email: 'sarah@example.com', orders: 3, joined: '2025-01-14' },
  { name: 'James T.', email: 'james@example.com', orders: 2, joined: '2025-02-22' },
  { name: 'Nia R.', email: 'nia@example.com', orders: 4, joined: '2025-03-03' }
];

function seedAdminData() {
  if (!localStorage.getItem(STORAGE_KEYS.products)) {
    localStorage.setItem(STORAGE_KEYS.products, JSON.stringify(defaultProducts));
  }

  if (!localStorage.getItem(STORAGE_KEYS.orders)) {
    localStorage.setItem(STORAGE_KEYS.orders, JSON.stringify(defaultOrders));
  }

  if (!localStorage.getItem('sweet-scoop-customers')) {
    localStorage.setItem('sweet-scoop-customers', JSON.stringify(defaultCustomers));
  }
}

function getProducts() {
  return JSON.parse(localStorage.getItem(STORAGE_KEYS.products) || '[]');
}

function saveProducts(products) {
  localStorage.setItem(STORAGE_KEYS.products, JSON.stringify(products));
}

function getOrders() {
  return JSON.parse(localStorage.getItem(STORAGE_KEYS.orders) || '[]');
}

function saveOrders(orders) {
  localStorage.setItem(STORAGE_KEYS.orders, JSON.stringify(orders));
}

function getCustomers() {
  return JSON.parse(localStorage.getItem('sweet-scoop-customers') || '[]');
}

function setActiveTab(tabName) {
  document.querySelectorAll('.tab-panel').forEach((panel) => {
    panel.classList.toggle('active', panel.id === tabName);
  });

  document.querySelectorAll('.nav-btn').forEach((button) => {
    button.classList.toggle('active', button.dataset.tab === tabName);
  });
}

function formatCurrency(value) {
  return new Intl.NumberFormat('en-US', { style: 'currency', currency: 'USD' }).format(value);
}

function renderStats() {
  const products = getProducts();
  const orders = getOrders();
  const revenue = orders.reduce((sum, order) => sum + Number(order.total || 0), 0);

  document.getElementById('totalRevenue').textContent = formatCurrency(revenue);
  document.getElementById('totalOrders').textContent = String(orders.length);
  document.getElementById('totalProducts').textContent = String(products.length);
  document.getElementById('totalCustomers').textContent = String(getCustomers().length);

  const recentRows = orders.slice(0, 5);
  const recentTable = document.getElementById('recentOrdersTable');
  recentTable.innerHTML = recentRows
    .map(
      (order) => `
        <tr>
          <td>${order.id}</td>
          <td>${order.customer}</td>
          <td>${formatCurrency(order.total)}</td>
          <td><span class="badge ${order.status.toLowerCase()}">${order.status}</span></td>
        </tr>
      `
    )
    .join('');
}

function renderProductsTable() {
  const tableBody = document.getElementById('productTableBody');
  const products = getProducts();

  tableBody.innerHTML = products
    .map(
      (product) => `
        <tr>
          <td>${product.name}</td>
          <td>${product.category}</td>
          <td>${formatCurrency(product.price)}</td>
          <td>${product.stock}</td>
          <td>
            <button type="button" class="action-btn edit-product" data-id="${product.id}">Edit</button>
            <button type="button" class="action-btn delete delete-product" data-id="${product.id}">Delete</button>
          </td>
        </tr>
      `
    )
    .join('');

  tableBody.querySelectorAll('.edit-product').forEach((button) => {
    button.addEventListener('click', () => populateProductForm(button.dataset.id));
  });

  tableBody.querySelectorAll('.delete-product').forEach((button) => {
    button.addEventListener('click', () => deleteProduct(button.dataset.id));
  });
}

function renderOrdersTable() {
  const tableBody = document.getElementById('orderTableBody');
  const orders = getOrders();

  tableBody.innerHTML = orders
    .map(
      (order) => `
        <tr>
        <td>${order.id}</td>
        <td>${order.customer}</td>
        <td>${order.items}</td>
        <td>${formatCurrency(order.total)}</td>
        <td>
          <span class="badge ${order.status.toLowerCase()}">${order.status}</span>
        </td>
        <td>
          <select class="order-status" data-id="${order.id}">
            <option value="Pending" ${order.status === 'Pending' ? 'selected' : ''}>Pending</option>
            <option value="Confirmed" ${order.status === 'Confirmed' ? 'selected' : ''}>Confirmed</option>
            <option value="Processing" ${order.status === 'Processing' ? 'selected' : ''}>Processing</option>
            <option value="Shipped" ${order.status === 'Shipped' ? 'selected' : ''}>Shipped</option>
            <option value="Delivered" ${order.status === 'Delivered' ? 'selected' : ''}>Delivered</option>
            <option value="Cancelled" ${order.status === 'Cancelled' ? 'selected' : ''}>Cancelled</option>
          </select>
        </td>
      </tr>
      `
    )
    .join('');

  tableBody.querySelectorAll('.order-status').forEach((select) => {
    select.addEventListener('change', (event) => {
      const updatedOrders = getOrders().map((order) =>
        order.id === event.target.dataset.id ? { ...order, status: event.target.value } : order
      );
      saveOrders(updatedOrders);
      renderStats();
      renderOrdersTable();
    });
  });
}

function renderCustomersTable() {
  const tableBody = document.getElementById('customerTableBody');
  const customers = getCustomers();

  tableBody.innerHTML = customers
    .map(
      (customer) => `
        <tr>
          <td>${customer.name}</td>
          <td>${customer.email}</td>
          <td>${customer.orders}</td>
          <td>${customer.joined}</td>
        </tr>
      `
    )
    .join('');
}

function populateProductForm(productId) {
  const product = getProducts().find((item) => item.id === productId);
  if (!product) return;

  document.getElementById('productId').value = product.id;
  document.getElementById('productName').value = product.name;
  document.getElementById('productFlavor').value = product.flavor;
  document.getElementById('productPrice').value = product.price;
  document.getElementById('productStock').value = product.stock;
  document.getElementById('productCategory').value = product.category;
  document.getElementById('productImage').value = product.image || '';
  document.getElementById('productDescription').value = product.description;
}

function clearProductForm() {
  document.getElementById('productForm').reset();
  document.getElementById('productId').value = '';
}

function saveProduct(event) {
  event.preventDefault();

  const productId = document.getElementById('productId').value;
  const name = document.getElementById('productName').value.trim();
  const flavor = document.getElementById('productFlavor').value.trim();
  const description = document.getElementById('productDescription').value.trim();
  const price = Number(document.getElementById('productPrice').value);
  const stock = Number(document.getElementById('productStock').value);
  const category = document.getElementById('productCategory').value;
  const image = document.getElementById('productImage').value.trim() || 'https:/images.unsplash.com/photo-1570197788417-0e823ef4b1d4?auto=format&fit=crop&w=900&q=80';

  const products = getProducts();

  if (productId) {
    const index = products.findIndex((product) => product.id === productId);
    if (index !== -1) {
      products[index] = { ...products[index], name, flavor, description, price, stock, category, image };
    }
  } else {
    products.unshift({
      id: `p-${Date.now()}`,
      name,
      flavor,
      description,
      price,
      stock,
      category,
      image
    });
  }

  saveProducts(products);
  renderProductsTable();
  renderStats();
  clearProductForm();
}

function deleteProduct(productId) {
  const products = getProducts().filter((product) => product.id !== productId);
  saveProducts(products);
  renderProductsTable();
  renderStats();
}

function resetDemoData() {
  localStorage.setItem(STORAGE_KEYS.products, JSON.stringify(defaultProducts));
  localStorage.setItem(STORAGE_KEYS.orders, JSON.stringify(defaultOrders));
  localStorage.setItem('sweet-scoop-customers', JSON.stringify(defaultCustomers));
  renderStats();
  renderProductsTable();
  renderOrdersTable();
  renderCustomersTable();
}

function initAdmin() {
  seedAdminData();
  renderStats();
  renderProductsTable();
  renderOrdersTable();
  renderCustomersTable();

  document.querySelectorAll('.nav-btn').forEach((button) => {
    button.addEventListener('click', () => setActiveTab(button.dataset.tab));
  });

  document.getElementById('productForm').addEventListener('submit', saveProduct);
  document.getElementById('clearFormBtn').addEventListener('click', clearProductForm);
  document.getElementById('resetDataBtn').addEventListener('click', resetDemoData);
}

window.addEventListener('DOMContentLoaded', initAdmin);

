public/admin/dashboard.css

:root {
  --bg: #fff8f5;
  --panel: #ffffff;
  --soft: #fff0ea;
  --primary: #ff7aa2;
  --primary-dark: #ea5f8d;
  --accent: #f6d9a0;
  --text: #181818;
  --muted: #606060;
  --line: rgba(130, 92, 91, 0.12);
  --success: #2bb673;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Inter", sans-serif;
  color: var(--text);
  background: var(--bg);
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.admin-shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

.sidebar {
  background: #1d1214;
  color: white;
  padding: 26px 20px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 8px 30px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #ffb5d1);
  color: white;
  font-weight: 800;
}

.brand-block strong,
.brand-block small {
  display: block;
}

.brand-block small {
  color: rgba(255,255,255,0.7);
}

.side-nav {
  display: grid;
  gap: 10px;
}

.nav-btn {
  width: 100%;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  background: rgba(255,255,255,0.03);
  color: rgba(255,255,255,0.8);
  text-align: left;
  padding: 12px 14px;
  font-weight: 600;
}

.nav-btn.active {
  background: rgba(255, 122, 162, 0.15);
  border-color: rgba(255, 122, 162, 0.36);
  color: white;
}

.main-panel {
  padding: 26px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  color: var(--primary-dark);
  font-weight: 700;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.primary-btn,
.secondary-btn {
  border: 0;
  border-radius: 999px;
  min-height: 46px;
  padding: 0 18px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
}

.secondary-btn {
  background: white;
  border: 1px solid var(--line);
  color: var(--text);
}

.tab-panel {
  display: none;
}

.tab-panel.active {
  display: block;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

.stat-card,
.panel-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: 0 14px 30px rgba(26, 18, 20, 0.04);
}

.stat-card {
  padding: 20px;
}

.stat-card span {
  display: block;
  color: var(--muted);
  margin-bottom: 12px;
}

.stat-card strong {
  font-size: clamp(1.6rem, 3vw, 2.3rem);
}

.panel-grid {
  display: grid;
  gap: 22px;
}

.panel-card {
  padding: 22px;
}

.panel-card h3 {
  margin: 0 0 18px;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 14px 10px;
  text-align: left;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

th {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 7px 10px;
  border: 1px solid rgba(12, 87, 67, 0.12);
}

.badge.pending { background: rgba(255, 193, 7, 0.12); color: #a96b00; }
.badge.confirmed { background: rgba(30, 144, 255, 0.12); color: #0a67d1; }
.badge.shipped { background: rgba(80, 120, 255, 0.12); color: #3249d5; }
.badge.delivered { background: rgba(43, 182, 115, 0.14); color: var(--success); }
.badge.cancelled { background: rgba(255, 87, 87, 0.12); color: #d14242; }

.product-form {
  display: grid;
  gap: 14px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.product-form input,
.product-form textarea,
.product-form select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 12px;
  min-height: 46px;
  padding: 0 14px;
  background: white;
  outline: none;
}

textarea {
  padding-top: 12px !important;
  resize: vertical;
  min-height: 110px;
}

.form-actions {
  display: flex;
  gap: 12px;
  align-items: center;
}

.action-btn {
  background: transparent;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 8px 10px;
  font-weight: 600;
}

.action-btn.delete {
  color: #d33a3a;
}

@media (max-width: 860px) {
  .admin-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    padding-bottom: 10px;
  }

  .stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .stat-grid,
  .field-grid {
    grid-template-columns: 1fr;
  }
}














































